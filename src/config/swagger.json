{
  "openapi": "3.0.3",
  "info": {
    "title": "Hub de Eventos API",
    "version": "1.0.0",
    "description": "API RESTful para cadastro de usuários e eventos, com controle de presenças e atualização das vagas disponíveis."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Verificação de funcionamento da API"
    },
    {
      "name": "Usuários",
      "description": "Cadastro e manutenção de usuários"
    },
    {
      "name": "Eventos",
      "description": "Cadastro e manutenção de eventos"
    },
    {
      "name": "Presenças",
      "description": "Marcação e cancelamento de presença em eventos"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Verificar status da API",
        "description": "Retorna o status do servidor e o horário atual.",
        "responses": {
          "200": {
            "description": "Servidor em funcionamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "OK",
                  "mensagem": "Servidor rodando com sucesso.",
                  "timestamp": "2026-10-03T12:00:00.000Z"
                }
              }
            }
          }
        }
      }
    },
    "/usuarios": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Listar usuários",
        "description": "Retorna todos os usuários cadastrados, ordenados pelo ID.",
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Usuario"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "nome": "Ana Silva",
                    "email": "ana.silva@email.com",
                    "createdAt": "2026-10-03T12:00:00.000Z",
                    "updatedAt": "2026-10-03T12:00:00.000Z"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao listar usuários.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Usuários"],
        "summary": "Cadastrar usuário",
        "description": "Cadastra um novo usuário. O e-mail é normalizado para letras minúsculas e deve ser único.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                },
                "example": {
                  "id": 1,
                  "nome": "Ana Silva",
                  "email": "ana.silva@email.com",
                  "createdAt": "2026-10-03T12:00:00.000Z",
                  "updatedAt": "2026-10-03T12:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "nomeAusente": {
                    "summary": "Nome ausente",
                    "value": {
                      "erro": "O campo nome é obrigatório."
                    }
                  },
                  "emailInvalido": {
                    "summary": "E-mail inválido",
                    "value": {
                      "erro": "Informe um e-mail válido."
                    }
                  },
                  "emailDuplicado": {
                    "summary": "E-mail já cadastrado",
                    "value": {
                      "erro": "Já existe um usuário cadastrado com este e-mail."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao cadastrar usuário.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      }
    },
    "/usuarios/{id}": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Buscar usuário por ID",
        "description": "Retorna os dados de um usuário específico.",
        "parameters": [
          {
            "$ref": "#/components/parameters/UsuarioId"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                },
                "example": {
                  "id": 1,
                  "nome": "Ana Silva",
                  "email": "ana.silva@email.com",
                  "createdAt": "2026-10-03T12:00:00.000Z",
                  "updatedAt": "2026-10-03T12:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "O ID informado deve ser um número válido."
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Usuário não encontrado."
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao buscar usuário.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Usuários"],
        "summary": "Atualizar usuário",
        "description": "Substitui o nome e o e-mail de um usuário existente.",
        "parameters": [
          {
            "$ref": "#/components/parameters/UsuarioId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                },
                "example": {
                  "id": 1,
                  "nome": "Ana Silva Souza",
                  "email": "ana.silva@email.com",
                  "createdAt": "2026-10-03T12:00:00.000Z",
                  "updatedAt": "2026-10-04T09:30:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "idInvalido": {
                    "summary": "ID inválido",
                    "value": {
                      "erro": "O ID informado deve ser um número válido."
                    }
                  },
                  "nomeAusente": {
                    "summary": "Nome ausente",
                    "value": {
                      "erro": "O campo nome é obrigatório."
                    }
                  },
                  "emailDuplicado": {
                    "summary": "E-mail em uso",
                    "value": {
                      "erro": "Este e-mail já está em uso."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Usuário não encontrado."
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao atualizar usuário.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Usuários"],
        "summary": "Excluir usuário",
        "description": "Remove o usuário. Suas presenças são excluídas e as vagas correspondentes são devolvidas aos eventos.",
        "parameters": [
          {
            "$ref": "#/components/parameters/UsuarioId"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário excluído",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuário excluído com sucesso."
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "O ID informado deve ser um número válido."
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Usuário não encontrado."
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao excluir usuário.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      }
    },
    "/eventos": {
      "get": {
        "tags": ["Eventos"],
        "summary": "Listar eventos",
        "description": "Retorna todos os eventos cadastrados, ordenados pela data de realização.",
        "responses": {
          "200": {
            "description": "Lista de eventos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Evento"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "titulo": "Semana de Tecnologia",
                    "descricao": "Palestras e oficinas sobre desenvolvimento web.",
                    "local": "Auditório Principal",
                    "data": "2026-11-20T19:00:00.000Z",
                    "vagasTotais": 50,
                    "vagasDisponiveis": 50,
                    "createdAt": "2026-10-03T12:00:00.000Z",
                    "updatedAt": "2026-10-03T12:00:00.000Z"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao listar eventos.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Eventos"],
        "summary": "Cadastrar evento",
        "description": "Cadastra um novo evento. O campo vagasDisponiveis é inicializado com o valor de vagasTotais.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Evento cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evento"
                },
                "example": {
                  "id": 1,
                  "titulo": "Semana de Tecnologia",
                  "descricao": "Palestras e oficinas sobre desenvolvimento web.",
                  "local": "Auditório Principal",
                  "data": "2026-11-20T19:00:00.000Z",
                  "vagasTotais": 50,
                  "vagasDisponiveis": 50,
                  "createdAt": "2026-10-03T12:00:00.000Z",
                  "updatedAt": "2026-10-03T12:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "tituloAusente": {
                    "summary": "Título ausente",
                    "value": {
                      "erro": "O campo titulo é obrigatório."
                    }
                  },
                  "dataInvalida": {
                    "summary": "Data inválida",
                    "value": {
                      "erro": "O campo data deve conter uma data válida."
                    }
                  },
                  "vagasInvalidas": {
                    "summary": "Vagas inválidas",
                    "value": {
                      "erro": "O campo vagasTotais deve ser um número inteiro maior que zero."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao cadastrar evento.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      }
    },
    "/eventos/{id}": {
      "get": {
        "tags": ["Eventos"],
        "summary": "Buscar evento por ID",
        "description": "Retorna os dados de um evento específico.",
        "parameters": [
          {
            "$ref": "#/components/parameters/EventoId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evento encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evento"
                },
                "example": {
                  "id": 1,
                  "titulo": "Semana de Tecnologia",
                  "descricao": "Palestras e oficinas sobre desenvolvimento web.",
                  "local": "Auditório Principal",
                  "data": "2026-11-20T19:00:00.000Z",
                  "vagasTotais": 50,
                  "vagasDisponiveis": 50,
                  "createdAt": "2026-10-03T12:00:00.000Z",
                  "updatedAt": "2026-10-03T12:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "O ID informado deve ser um número válido."
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Evento não encontrado."
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao buscar evento.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Eventos"],
        "summary": "Atualizar evento",
        "description": "Substitui os dados do evento. As vagas disponíveis são recalculadas preservando as presenças já marcadas.",
        "parameters": [
          {
            "$ref": "#/components/parameters/EventoId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evento atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evento"
                },
                "example": {
                  "id": 1,
                  "titulo": "Semana de Tecnologia",
                  "descricao": "Palestras e oficinas sobre desenvolvimento web.",
                  "local": "Auditório Principal",
                  "data": "2026-11-20T19:00:00.000Z",
                  "vagasTotais": 60,
                  "vagasDisponiveis": 58,
                  "createdAt": "2026-10-03T12:00:00.000Z",
                  "updatedAt": "2026-10-04T09:30:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "idInvalido": {
                    "summary": "ID inválido",
                    "value": {
                      "erro": "O ID informado deve ser um número válido."
                    }
                  },
                  "localAusente": {
                    "summary": "Local ausente",
                    "value": {
                      "erro": "O campo local é obrigatório."
                    }
                  },
                  "vagasInsuficientes": {
                    "summary": "Vagas menores que as presenças",
                    "value": {
                      "erro": "O total de vagas não pode ser menor que o número de presenças já marcadas (2)."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Evento não encontrado."
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao atualizar evento.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Eventos"],
        "summary": "Excluir evento",
        "description": "Remove o evento e, em cascata, todas as presenças vinculadas a ele.",
        "parameters": [
          {
            "$ref": "#/components/parameters/EventoId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evento excluído",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Evento excluído com sucesso."
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "O ID informado deve ser um número válido."
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Evento não encontrado."
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": "Erro ao excluir evento.",
                  "detalhe": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      }
    },
    "/eventos/{id}/presencas": {
      "post": {
        "tags": ["Presenças"],
        "summary": "Marcar presença",
        "description": "Registra a presença de um usuário no evento e decrementa em 1 o número de vagas disponíveis.",
        "parameters": [
          {
            "$ref": "#/components/parameters/EventoId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresencaInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Presença marcada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresencaResposta"
                },
                "example": {
                  "mensagem": "Presença marcada com sucesso.",
                  "eventoId": 1,
                  "usuarioId": 1,
                  "vagasDisponiveis": 49
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "eventoIdInvalido": {
                    "summary": "ID do evento inválido",
                    "value": {
                      "erro": "O ID do evento deve ser um número válido."
                    }
                  },
                  "usuarioIdInvalido": {
                    "summary": "usuarioId inválido",
                    "value": {
                      "erro": "O campo usuarioId deve ser um número válido."
                    }
                  },
                  "presencaDuplicada": {
                    "summary": "Presença já marcada",
                    "value": {
                      "erro": "O usuário já possui presença marcada neste evento."
                    }
                  },
                  "semVagas": {
                    "summary": "Evento lotado",
                    "value": {
                      "erro": "Não há vagas disponíveis neste evento."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "eventoNaoEncontrado": {
                    "summary": "Evento não encontrado",
                    "value": {
                      "erro": "Evento não encontrado."
                    }
                  },
                  "usuarioNaoEncontrado": {
                    "summary": "Usuário não encontrado",
                    "value": {
                      "erro": "Usuário não encontrado."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
